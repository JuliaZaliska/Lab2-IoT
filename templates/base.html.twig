 <!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}IoT Telemetry Hub{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --sidebar-bg: #111827;
            --sidebar-hover: #1f2937;
            --workspace-bg: #f8fafc;
            --border-color: #e2e8f0;
            --ok: #10b981;
            --warn: #f59e0b;
            --danger: #ef4444;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--workspace-bg);
            color: #0f172a;
            margin: 0;
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .app-shell {
            display: flex;
            min-height: 100vh;
        }
        .sidebar {
            width: 245px;
            background: var(--sidebar-bg);
            color: #cbd5e1;
            padding: 1.5rem 1rem;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.9rem;
            border-radius: 8px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 500;
            margin-bottom: 4px;
            transition: background 0.15s, color 0.15s;
        }
        .sidebar-link:hover, .sidebar-link.active {
            background: var(--sidebar-hover);
            color: #ffffff;
        }
        .workspace {
            flex-grow: 1;
            padding: 1.75rem 2rem;
            overflow-x: hidden;
        }
        .surface {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
        }
        .led {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }
        .led-online { background: var(--ok); }
        .led-offline { background: #94a3b8; }
        .led-maintenance { background: var(--warn); }
        .led-alert {
            background: var(--danger);
            animation: blink 1.2s infinite;
        }
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.25; }
        }
        @media (max-width: 991px) {
            .app-shell { flex-direction: column; }
            .sidebar { width: 100%; padding: 1rem; }
            .workspace { padding: 1rem; }
        }
    </style>
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="px-2 mb-4">
            <div class="mono text-info small fw-bold">SCADA · v2.0</div>
            <div class="fs-5 fw-bold text-white">IoT Telemetry</div>
        </div>

        <nav class="flex-grow-1">
            <a href="{{ path('app_sensor_index') }}" class="sidebar-link active">📊 Дашборд датчиків</a>
            <a href="{{ path('app_sensor_index', {alerts: 1}) }}" class="sidebar-link">🚨 Активні тривоги</a>
            <a href="/api/sensors" target="_blank" class="sidebar-link mono small">{} JSON API</a>
            <hr class="border-secondary opacity-25 my-3">
            <a href="/admin" class="sidebar-link">⚙️ Адмін-панель</a>
        </nav>

        <div class="px-2 pt-3 border-top border-secondary border-opacity-25 small text-secondary mono">
            Symfony + Doctrine<br>SQLite Telemetry DB
        </div>
    </aside>

    <main class="workspace">
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>