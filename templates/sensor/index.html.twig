 {% extends 'base.html.twig' %}

{% block title %}Дашборд — IoT Telemetry{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Моніторинг телеметрії</h1>
            <div class="text-muted small">Стан підключених датчиків та контроль граничних порогів</div>
        </div>
        <a href="/admin" class="btn btn-dark btn-sm px-3">+ Додати датчик</a>
    </div>

    {# KPI-показники #}
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="surface p-3">
                <div class="text-muted small">Усього пристроїв</div>
                <div class="fs-3 fw-bold mono">{{ stats.total }}</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="surface p-3">
                <div class="text-muted small">Онлайн</div>
                <div class="fs-3 fw-bold mono text-success">{{ stats.online }}</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="surface p-3">
                <div class="text-muted small">Офлайн / ТО</div>
                <div class="fs-3 fw-bold mono text-secondary">{{ stats.offline }}</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="surface p-3 {{ stats.alerts > 0 ? 'border-danger bg-danger-subtle' : '' }}">
                <div class="small {{ stats.alerts > 0 ? 'text-danger fw-semibold' : 'text-muted' }}">Активні тривоги</div>
                <div class="fs-3 fw-bold mono {{ stats.alerts > 0 ? 'text-danger' : '' }}">{{ stats.alerts }}</div>
            </div>
        </div>
    </div>

    {# Графік навантаження (% від порогу тривоги) #}
    {% if sensors is not empty %}
        <div class="surface p-3 p-md-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 fw-bold mb-0">Навантаження датчиків (% від порогу тривоги)</h2>
                <span class="badge text-bg-light border mono">100%+ = ТРИВОГА</span>
            </div>
            <div style="height: 230px;">
                <canvas id="sensorsChart"></canvas>
            </div>
        </div>
    {% endif %}

    {# Панель фільтрів (QueryBuilder) #}
    <form method="get" action="{{ path('app_sensor_index') }}" class="surface p-3 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="q" value="{{ currentQuery }}" class="form-control form-control-sm"
                       placeholder="Пошук датчика або типу...">
            </div>
            <div class="col-md-3">
                <select name="location" class="form-select form-select-sm">
                    <option value="">Усі локації</option>
                    {% for loc in locations %}
                        <option value="{{ loc.id }}" {{ currentLocation == loc.id ? 'selected' : '' }}>
                            {{ loc.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">Усі статуси</option>
                    <option value="online" {{ currentStatus == 'online' ? 'selected' : '' }}>Online</option>
                    <option value="offline" {{ currentStatus == 'offline' ? 'selected' : '' }}>Offline</option>
                    <option value="maintenance" {{ currentStatus == 'maintenance' ? 'selected' : '' }}>Maintenance</option>
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" name="alerts" value="1" id="alertsOnly"
                           {{ onlyAlerts ? 'checked' : '' }}>
                    <label class="form-check-label small text-danger fw-medium" for="alertsOnly">Тільки тривоги</label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-dark w-100">Застосувати</button>
                {% if currentQuery or currentLocation or currentStatus or onlyAlerts %}
                    <a href="{{ path('app_sensor_index') }}" class="btn btn-sm btn-outline-secondary">✕</a>
                {% endif %}
            </div>
        </div>
    </form>

    {# Таблиця телеметрії #}
    <div class="surface overflow-hidden">
        {% if sensors is empty %}
            <div class="p-4 text-center text-muted">
                Датчиків не знайдено. Запустіть <code class="mono">php bin/console app:seed-iot</code> або додайте їх в адмінці.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">Датчик</th>
                            <th>Локація</th>
                            <th>Показник</th>
                            <th>Поріг</th>
                            <th>Статус</th>
                            <th class="text-end pe-3">Дія</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sensor in sensors %}
                            {% set alert = sensor.isAlert() %}
                            <tr class="{{ alert ? 'table-danger' : '' }}">
                                <td class="ps-3">
                                    <div class="fw-semibold">{{ sensor.name }}</div>
                                    <div class="small text-muted">{{ sensor.sensorType }}</div>
                                </td>
                                <td>
                                    <div>{{ sensor.location.name }}</div>
                                    <div class="small text-muted">{{ sensor.location.zone }}</div>
                                </td>
                                <td class="mono fw-bold fs-6 {{ alert ? 'text-danger' : '' }}">
                                    {{ sensor.currentValue }} {{ sensor.unit }}
                                </td>
                                <td class="mono text-muted small">
                                    {{ sensor.alertThreshold is not null ? sensor.alertThreshold ~ ' ' ~ sensor.unit : '—' }}
                                </td>
                                <td>
                                    <span class="badge {{ alert ? 'bg-danger' : (sensor.status == 'online' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary') }} mono">
                                        <span class="led {{ alert ? 'led-alert' : 'led-' ~ sensor.status }} me-1"></span>
                                        {{ alert ? 'ALERT' : sensor.status|upper }}
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a href="{{ path('app_sensor_show', {id: sensor.id}) }}" class="btn btn-sm btn-outline-dark">
                                        Графік →
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {% if sensors is not empty %}
        <script>
            const labels = [{% for s in sensors %}{{ s.name|json_encode|raw }},{% endfor %}];
            const percents = [{% for s in sensors %}{{ s.alertThreshold ? ((s.currentValue / s.alertThreshold) * 100)|round(1) : 0 }},{% endfor %}];
            const colors = percents.map(p => p >= 100 ? '#ef4444' : (p >= 80 ? '#f59e0b' : '#0ea5e9'));

            new Chart(document.getElementById('sensorsChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: '% від порогу тривоги',
                        data: percents,
                        backgroundColor: colors,
                        borderRadius: 6,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            suggestedMax: 120,
                            ticks: { callback: v => v + '%' }
                        }
                    }
                }
            });
        </script>
    {% endif %}
{% endblock %}