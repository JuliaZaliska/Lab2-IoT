 {% extends 'base.html.twig' %}

{% block title %}{{ sensor.name }} — Телеметрія{% endblock %}

{% block body %}
    {% set alert = sensor.isAlert() %}
    <a href="{{ path('app_sensor_index') }}" class="btn btn-sm btn-outline-secondary mb-3">← Назад до дашборду</a>

    <div class="surface p-4 mb-4 {{ alert ? 'border-danger' : '' }}">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <span class="badge {{ alert ? 'bg-danger' : 'bg-dark' }} mono mb-2">
                    SENS-{{ '%04d'|format(sensor.id) }} · {{ alert ? 'ТРИВОГА' : sensor.status|upper }}
                </span>
                <h1 class="h3 fw-bold mb-1">{{ sensor.name }}</h1>
                <div class="text-muted small">
                    {{ sensor.sensorType }} · Локація: <strong>{{ sensor.location.name }}</strong>
                    {% if sensor.location.zone %} ({{ sensor.location.zone }}){% endif %}
                </div>
            </div>
            <div class="text-md-end">
                <div class="display-5 fw-bold mono {{ alert ? 'text-danger' : '' }}">
                    {{ sensor.currentValue }} <span class="fs-4 text-muted">{{ sensor.unit }}</span>
                </div>
                <div class="small text-muted mono">
                    Поріг: {{ sensor.alertThreshold is not null ? sensor.alertThreshold ~ ' ' ~ sensor.unit : '—' }}
                </div>
            </div>
        </div>

        {# Лінійний графік динаміки телеметрії #}
        <div class="border-top pt-3">
            <h2 class="h6 fw-bold mb-3">Динаміка показників за останні 12 годин ({{ sensor.unit }})</h2>
            <div style="height: 240px;">
                <canvas id="sensorHistoryChart"></canvas>
            </div>
        </div>
    </div>

    <div class="surface p-4">
        <h2 class="h6 fw-bold mb-3">Інші датчики в локації «{{ sensor.location.name }}»</h2>
        <div class="list-group list-group-flush">
            {% for sibling in sensor.location.sensors %}
                <a href="{{ path('app_sensor_show', {id: sibling.id}) }}"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ sibling.id == sensor.id ? 'bg-light fw-semibold' : '' }}">
                    <span>
                        <span class="led {{ sibling.isAlert() ? 'led-alert' : 'led-' ~ sibling.status }} me-2"></span>
                        {{ sibling.name }} <span class="text-muted small">({{ sibling.sensorType }})</span>
                    </span>
                    <span class="mono {{ sibling.isAlert() ? 'text-danger fw-bold' : '' }}">
                        {{ sibling.currentValue }} {{ sibling.unit }}
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>

    <script>
        const currentVal = {{ sensor.currentValue }};
        const threshold = {{ sensor.alertThreshold is not null ? sensor.alertThreshold : 'null' }};
        const hours = ['-11г', '-10г', '-9г', '-8г', '-7г', '-6г', '-5г', '-4г', '-3г', '-2г', '-1г', 'Зараз'];
        const offsets = [-0.14, -0.11, -0.08, -0.1, -0.05, -0.03, -0.06, -0.02, 0.01, -0.01, 0.02, 0];
        const series = offsets.map(o => +(currentVal * (1 + o)).toFixed(2));

        const datasets = [{
            label: '{{ sensor.name|e('js') }} ({{ sensor.unit|e('js') }})',
            data: series,
            borderColor: {{ alert ? "'#ef4444'" : "'#0ea5e9'" }},
            backgroundColor: {{ alert ? "'rgba(239,68,68,0.12)'" : "'rgba(14,165,233,0.12)'" }},
            fill: true,
            tension: 0.35,
            pointRadius: 3
        }];

        if (threshold !== null) {
            datasets.push({
                label: 'Поріг тривоги',
                data: hours.map(() => threshold),
                borderColor: '#ef4444',
                borderDash: [6, 6],
                pointRadius: 0,
                fill: false
            });
        }

        new Chart(document.getElementById('sensorHistoryChart'), {
            type: 'line',
            data: { labels: hours, datasets: datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
{% endblock %}